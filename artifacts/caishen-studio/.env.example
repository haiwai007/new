# Leave these unset for fully local, no-login use.
# Frontend values are public and included in the browser bundle. Never put secrets here.
VITE_CONVEX_URL=
VITE_HERCULES_OIDC_AUTHORITY=
VITE_HERCULES_OIDC_CLIENT_ID=
# Optional; defaults to the current site origin + /auth/callback.
# VITE_HERCULES_OIDC_REDIRECT_URI=
