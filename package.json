{
  "name": "workspace",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm typecheck && pnpm build:studio",
    "typecheck": "pnpm --filter @workspace/caishen-studio typecheck && pnpm exec tsc -p artifacts/caishen-studio/convex/tsconfig.json --noEmit",
    "dev": "pnpm --filter @workspace/caishen-studio dev",
    "build:studio": "pnpm --filter @workspace/caishen-studio build",
    "test:studio": "pnpm --filter @workspace/caishen-studio test",
    "test:e2e": "pnpm --filter @workspace/caishen-studio test:e2e",
    "test:cms": "CMS_E2E=1 E2E_PORT=5180 pnpm test:e2e cms.spec.ts cms-submissions.spec.ts",
    "cms:password": "node scripts/create-admin-password.mjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  }
}
