// Optional CLI deployment example. Replace IDs/names before using; dashboard bindings are the default setup path.
{
  "name": "new",
  "pages_build_output_dir": "../artifacts/caishen-studio/dist/public",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "haishen-catalog",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
    },
  ],
  "r2_buckets": [
    { "binding": "CATALOG_FILES", "bucket_name": "haishen-template-files" },
  ],
}
